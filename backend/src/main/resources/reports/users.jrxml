<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="users" language="java"
              pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="24" bottomMargin="24"
              whenNoDataType="AllSectionsNoDetail">

    <parameter name="SEARCH_LABEL" class="java.lang.String"/>
    <parameter name="GENERATED_AT" class="java.lang.String"/>
    <parameter name="GENERATED_BY" class="java.lang.String"/>
    <parameter name="TOTAL_RECORDS" class="java.lang.Integer"/>

    <field name="fullName" class="java.lang.String"/>
    <field name="email" class="java.lang.String"/>
    <field name="roles" class="java.lang.String"/>
    <field name="status" class="java.lang.String"/>
    <field name="createdAt" class="java.lang.String"/>

    <title>
        <band height="78">
            <staticText>
                <reportElement x="0" y="0" width="420" height="26" forecolor="#0F172A"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="20" isBold="true"/>
                </textElement>
                <text><![CDATA[Usuarios]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="28" width="555" height="16" forecolor="#64748B"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <text><![CDATA[Reportería · Listado de usuarios con roles, estado y fecha de alta]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="52" width="555" height="18" forecolor="#334155"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{SEARCH_LABEL}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="24">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="24" mode="Opaque" backcolor="#1E293B"/>
                <graphicElement>
                    <pen lineWidth="0"/>
                </graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="6" y="0" width="138" height="24" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Usuario]]></text>
            </staticText>
            <staticText>
                <reportElement x="156" y="0" width="163" height="24" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Correo]]></text>
            </staticText>
            <staticText>
                <reportElement x="331" y="0" width="78" height="24" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Roles]]></text>
            </staticText>
            <staticText>
                <reportElement x="421" y="0" width="48" height="24" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Estado]]></text>
            </staticText>
            <staticText>
                <reportElement x="481" y="0" width="68" height="24" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Alta]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="20">
            <line>
                <reportElement x="0" y="0" width="555" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#1E293B"/>
                </graphicElement>
            </line>
            <textField>
                <reportElement x="6" y="1" width="138" height="18" forecolor="#0F172A"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{fullName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="156" y="1" width="163" height="18" forecolor="#334155"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{email}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="331" y="1" width="78" height="18" forecolor="#334155"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{roles}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="421" y="1" width="48" height="18" forecolor="#334155"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="481" y="1" width="68" height="18" forecolor="#334155"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{createdAt}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="19" width="555" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#E2E8F0"/>
                </graphicElement>
            </line>
        </band>
    </detail>

    <pageFooter>
        <band height="22">
            <line>
                <reportElement x="0" y="0" width="555" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#E2E8F0"/>
                </graphicElement>
            </line>
            <textField>
                <reportElement x="0" y="4" width="360" height="14" forecolor="#64748B"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Generado el " + $P{GENERATED_AT} + " por " + $P{GENERATED_BY}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="395" y="4" width="38" height="14" forecolor="#64748B"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <text><![CDATA[Página]]></text>
            </staticText>
            <textField>
                <reportElement x="435" y="4" width="22" height="14" forecolor="#64748B"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="457" y="4" width="18" height="14" forecolor="#64748B"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <text><![CDATA[de]]></text>
            </staticText>
            <textField evaluationTime="Report">
                <reportElement x="475" y="4" width="22" height="14" forecolor="#64748B"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="42">
            <line>
                <reportElement x="0" y="0" width="555" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#1E293B"/>
                </graphicElement>
            </line>
            <textField>
                <reportElement x="0" y="10" width="300" height="18" forecolor="#0F172A"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Total de registros: " + $P{TOTAL_RECORDS}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="305" y="10" width="250" height="18" forecolor="#B91C1C">
                    <printWhenExpression><![CDATA[$P{TOTAL_RECORDS} == 0]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["No se encontraron usuarios con los filtros aplicados."]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>
